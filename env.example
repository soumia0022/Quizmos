# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore - never commit real secrets.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# True for local development only. Leave False (or unset) in production.
DEBUG=True

# Comma-separated list of hosts the site can be served on
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: production PostgreSQL database
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Optional: Redis for live polls (defaults to localhost:6379)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Optional: send real emails (e.g. password resets). Without these, emails print to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com
