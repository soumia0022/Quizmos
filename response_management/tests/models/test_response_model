from django.test import TestCase
from django.contrib.auth import get_user_model
from poll_management.models.poll_model import Poll
from response_management.models.response_model import MultipleChoiceResponse, SingleChoiceResponse, TextFillResponse, DropdownFillResponse

User = get_user_model()

class ResponseModelTest(TestCase):
    def setUp(self):
        self.user = User.objects.create_user(username='testuser', password='password', role='Student')
        self.poll = Poll.objects.create(
            title="Sample Poll",
            status="active",
            user=self.user,
            number_code=123456
        )

    def test_multiple_choice_response_creation(self):
        response = MultipleChoiceResponse.objects.create(
            user=self.user,
            poll=self.poll,
            selected_options={"option1": True, "option2": False}
        )
        
        self.assertEqual(response.user, self.user)
        self.assertEqual(response.poll, self.poll)
        self.assertEqual(response.selected_options, {"option1": True, "option2": False})
        self.assertIsNotNone(response.submitted_on)
    
    def test_single_choice_response_creation(self):
        response = SingleChoiceResponse.objects.create(
            user=self.user,
            poll=self.poll,
            selected_option="Option A"
        )
        
        self.assertEqual(response.user, self.user)
        self.assertEqual(response.poll, self.poll)
        self.assertEqual(response.selected_option, "Option A")
        self.assertIsNotNone(response.submitted_on)
    
    def test_text_fill_response_creation(self):
        response = TextFillResponse.objects.create(
            user=self.user,
            poll=self.poll,
            answer_text="This is my answer."
        )
        
        self.assertEqual(response.user, self.user)
        self.assertEqual(response.poll, self.poll)
        self.assertEqual(response.answer_text, "This is my answer.")
        self.assertIsNotNone(response.submitted_on)
    
    def test_dropdown_fill_response_creation(self):
        response = DropdownFillResponse.objects.create(
            user=self.user,
            poll=self.poll,
            selected_option="Dropdown Option 1"
        )
        
        self.assertEqual(response.user, self.user)
        self.assertEqual(response.poll, self.poll)
        self.assertEqual(response.selected_option, "Dropdown Option 1")
        self.assertIsNotNone(response.submitted_on)
